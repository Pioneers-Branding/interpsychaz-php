RewriteEngine On
RewriteBase /

# 1. Do not rewrite existing physical files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Redirect .html to clean URL (if requested directly)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# 3. Specific nested mappings (with or without trailing slash)
RewriteRule ^category/blog/?$ category__blog.php [L,QSA]
RewriteRule ^category/blog/page/([0-9]+)/?$ category__blog__page__$1.php [L,QSA]
RewriteRule ^for-providers/refer-a-patient/?$ for-providers__refer-a-patient.php [L,QSA]
RewriteRule ^for-providers__refer-a-patient/?$ for-providers__refer-a-patient.php [L,QSA]
RewriteRule ^category__blog/?$ category__blog.php [L,QSA]
RewriteRule ^category__blog__page__([0-9]+)/?$ category__blog__page__$1.php [L,QSA]

# Services and Treatments
RewriteRule ^services/tms-therapy/?$ services__tms-therapy.php [L,QSA]
RewriteRule ^services/electroconvulsive-therapy-ect/?$ services__electroconvulsive-therapy-ect.php [L,QSA]
RewriteRule ^services/spravato-esketamine-nasal-spray/?$ services__spravato-esketamine-nasal-spray.php [L,QSA]
RewriteRule ^services/medication-management/?$ services__medication-management.php [L,QSA]

RewriteRule ^treatments/tms-therapy/?$ treatments__tms-therapy.php [L,QSA]
RewriteRule ^treatments/ect/?$ treatments__ect.php [L,QSA]
RewriteRule ^treatments/spravato/?$ treatments__spravato.php [L,QSA]
RewriteRule ^treatments/medication-management/?$ treatments__medication-management.php [L,QSA]

# 4. Check if direct PHP file exists (e.g. /about or /about/ -> about.php)
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]

# 5. Check if post__ prefixed file exists (e.g. /depression-what-you-should-know -> post__depression-what-you-should-know.php)
RewriteCond %{DOCUMENT_ROOT}/post__$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ post__$1.php [L,QSA]

# 6. Fallback router for any other clean URL pattern
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ router.php [L,QSA]
